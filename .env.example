# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env a GitHub.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOCALIS_SECRET_KEY=
# Secreto opcional SOLO para los enlaces de vista previa de tiendas (pre-cuentas).
# Si se define, rotarlo revoca todos los enlaces de vista previa ya compartidos.
# Si se deja vacio, se usa LOCALIS_SECRET_KEY.
LOCALIS_PREVIEW_SECRET=
# Correos con permisos de administrador, separados por coma (o ';').
# Si se omite, se conserva el correo historico para no romper despliegues.
# Permite varios admins y cambiarlos sin desplegar codigo.
LOCALIS_ADMIN_EMAILS=
LOCALIS_WHATSAPP=
DATABASE_URL=
# Copia desde Supabase Dashboard -> Settings -> API -> Project URL.
# Exactamente https://<ref>.supabase.co (sin comillas, sin /rest/v1, sin host pegado delante).
SUPABASE_URL=https://TU_REF.supabase.co
# Anon/publishable: solo PostgREST de lectura (opcional). NUNCA la uses para Storage.
SUPABASE_KEY=
# Obligatorio en backend para Storage (subidas). Nombre exacto:
# SUPABASE_SERVICE_ROLE_KEY (con E en ROLE). Dashboard -> Settings -> API ->
# service_role (secret). Si pegaste aqui la llave anon, Storage devolvera 403 RLS
# y las URLs de imagen quedaran en None. El JWT debe tener "role": "service_role".
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_IMAGENES=imagenes

# Pipeline profesional de imágenes (100% local, sin suscripciones de pago).
# Se activa solo cuando el producto NO tiene foto subida por el comerciante.
# Flujo: EAN/UPC -> búsqueda web [nombre]+[marca]+[categoría]+"venezuela"
# -> validación de calidad -> rembg (fondo blanco) -> Supabase Storage.
# Cobertura universal: si no hay imagen real, se asigna un placeholder
# profesional de la categoría inferida (backend/categorias_producto.py).
LOCALIS_IMG_PIPELINE=1
# Parámetros finos (opcionales):
# LOCALIS_IMG_MIN_SIDE=320
# LOCALIS_IMG_MAX_CANDIDATOS=8
# LOCALIS_IMG_BLUR_MIN=35
# LOCALIS_IMG_LADO_FINAL=800
# LOCALIS_IMG_MAX_CONCURRENT=1
# LOCALIS_IMG_BUDGET_SEC=120
# Relleno real en segundo plano (acotado por tiempo para no saturar 1 CPU):
# LOCALIS_IMG_CSV_MAX=2000
# LOCALIS_IMG_CSV_BUDGET_SEC=600
# Búsqueda ligera en paralelo + caché + fuentes locales por sitio:
# LOCALIS_IMG_PARALELO=4
# LOCALIS_IMG_CACHE_TTL_SEC=3600
# LOCALIS_IMG_SITIOS=2
# LOCALIS_IMG_SITIOS_EXTRA=
# Fuentes locales directas (URL de imagen sin scraping):
#   VTEX (catálogo público): ya incluye Locatel (VE) y distribuidores regionales
#   (Carulla, Olímpica, Plaza Vea, Jumbo). Añade más tiendas VTEX separadas por coma.
# LOCALIS_IMG_VTEX_HOSTS=
#   Mercado Libre Venezuela (API oficial; requiere token de aplicación MELI)
# MELI_ACCESS_TOKEN=
# Serper.dev (Google Images) — buscador principal de imágenes automáticas:
#   UNA consulta por producto (EAN primero; si no, nombre + descripción) y el
#   resultado queda en el registro permanente `imagenes_automaticas`.
#   Ante 429/cuota agotada se pausa y el producto queda pendiente (sin caché).
#   OBLIGATORIA: sin SERPER_API_KEY el pipeline queda en estado neutro.
SERPER_API_KEY=
# LOCALIS_SERPER_GL=ve
# LOCALIS_SERPER_HL=es
# LOCALIS_SERPER_TIMEOUT_SEC=12
# LOCALIS_SERPER_REINTENTOS=2
# LOCALIS_SERPER_LIMITE=10
# LOCALIS_SERPER_MIN_LADO=200
# Control de créditos: tope diario duro y caché de consultas repetidas.
# LOCALIS_SERPER_MAX_DIA=90
# LOCALIS_SERPER_CACHE_TTL_SEC=86400
# LOCALIS_SERPER_CACHE_MAX=2000
# Reintento de negativos (días antes de volver a buscar por un EAN sin imagen).
# LOCALIS_SERPER_NEGATIVO_TTL_DIAS=7
# Serper en la cascada paralela (0 = solo vía registro automático, 1 = activar):
# LOCALIS_IMG_SERPER_CASCADA=0
# LOCALIS_IMG_SERPER_PARALELO=2
# LOCALIS_SERPER_CONFIG_COOLDOWN_SEG=3600
# LOCALIS_SERPER_CUOTA_COOLDOWN_SEG=3600
# Diagnóstico de credenciales al arrancar (una consulta de prueba; 0/1):
# LOCALIS_SERPER_DIAGNOSTICO=0
# Buscadores API globales (opcionales; máxima cobertura tipo búsqueda humana):
# SERPAPI_KEY=
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_V7_KEY=
# Anti-bloqueo: proxy HTTP(S) si la IP del VPS está bloqueada por buscadores/CDN
# LOCALIS_HTTP_PROXY=
# Pool de proxies públicos dinámicos (opt-in; usa proxies de terceros):
# LOCALIS_HTTP_PROXY_PUBLICO=0
# LOCALIS_HTTP_REINTENTOS=3
# LOCALIS_HTTP_BACKOFF_SEG=0.4
# Rastreo og:image de páginas de producto (emula búsqueda manual):
# LOCALIS_IMG_BING_OG=1
# Reintentos de descarga (CDN intermitentes):
# LOCALIS_IMG_DESCARGA_INTENTOS=2
# Enriquecimiento en paralelo (I/O) y trabajadores:
# LOCALIS_IMG_PARALELO=4
# LOCALIS_IMG_PARALELO_MAX=8
# LOCALIS_IMG_TRABAJADORES=4
# LOCALIS_IMG_TRABAJADORES_MAX=8
# Reintento periódico de imágenes pendientes/rechazadas (sin falsos positivos):
#   Cola persistente: cada ciclo procesa un lote en 30-60 s y sigue hasta lograr fotos reales.
# LOCALIS_IMG_BACKFILL=1# LOCALIS_IMG_BACKFILL_LOTE=20
# LOCALIS_IMG_BACKFILL_COMERCIOS=2
# LOCALIS_IMG_BACKFILL_PRESUPUESTO=50
# LOCALIS_IMG_BACKFILL_INTERVALO=90
# Catálogo público: tamaño de página (navegable) y tiendas ocultas (IDs por coma).
# LOCALIS_CATALOGO_PAGINA=60
# LOCALIS_COMERCIOS_EXCLUIDOS=
# Autorreparación de imágenes por importación (0 desactiva).
# LOCALIS_IMG_REPARAR_MAX=40
# Importación CSV/XLS: qué hacer con productos que ya no vienen en el archivo.
#   eliminar (por defecto): sincronización espejo, borra de la tienda los ausentes.
#   desactivar: los oculta (activo=0) sin borrarlos. | off: no toca los ausentes.
LOCALIS_CSV_BAJAS=eliminar
# Respaldo visual: SOLO logo OFICIAL de marca (nunca monogramas inventados).
# LOCALIS_MARCA_LOGO_TTL_SEC=86400
# Whitelist estricta de dominios para imágenes (0 solo para depurar):
# LOCALIS_IMG_ESTRICTO=1
# Hosts globales (site:) para sectores estructurados (separados por coma):
# LOCALIS_IMG_SITIOS_GLOBALES=
# Límite de CPU (rembg nunca corre en paralelo):
# LOCALIS_IMG_MAX_CONCURRENT=1
# LOCALIS_REMBG_MODEL=u2net
# Nota: la primera ejecución descarga el modelo de rembg (~176 MB) desde GitHub
# hacia el disco del worker. Con 1 worker Gunicorn (WEB_CONCURRENCY=1) es suficiente.
# Dominios extra de confianza (separados por coma):
# LOCALIS_IMG_DOMINIOS_CONFIABLES=

# Content-Security-Policy opcional. Vacio = no se envia (por defecto, porque
# las plantillas usan estilos/onclick inline). Para probar en una rama:
# LOCALIS_CSP=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'
LOCALIS_CSP=
# CSP en modo "solo reporte": el navegador NO bloquea, solo reporta violaciones.
# Es la forma de medir el impacto de una CSP estricta con riesgo cero antes de
# imponerla (LOCALIS_CSP). Recomendado desplegarlo primero unos dias.
LOCALIS_CSP_REPORT_ONLY=

# --- Observabilidad ---
# Formato de logs: vacio = texto legible; 1 = JSON estructurado (recomendado
# en produccion para poder filtrar/alertar). Cada peticion emite una linea de
# acceso con metodo, ruta, estado, duracion y request-id.
LOCALIS_LOG_JSON=
# Nivel de logging del logger raiz (INFO por defecto).
LOCALIS_LOG_LEVEL=INFO
# Metricas Prometheus: 1 expone GET /metrics (contadores por clase de estado y
# percentiles de latencia). Vacio = /metrics responde 404. Pensado para 1 worker.
LOCALIS_METRICS=
# Sentry (opcional). Vacio = no-op. Con DSN, se activa la integracion Flask
# (complementa el reporte por email de los errores 5xx).
LOCALIS_SENTRY_DSN=
# Muestreo de trazas de Sentry (0 = solo errores; 0.1 = 10% de peticiones).
LOCALIS_SENTRY_TRACES=0

# Rate limiting (Flask-Limiter) en endpoints sensibles (login, creacion de
# productos, pagos, importacion). Clave por usuario de sesion o IP.
# 0 lo desactiva. Limites pensados para no afectar trafico normal.
LOCALIS_RATE_LIMIT=1

# --- Cache en memoria (por worker; se pierde al reiniciar) ---
# TTL de la portada en segundos. 0 desactiva. Absorbe picos de trafico sin
# congelar demasiado el orden del "revoltijo".
LOCALIS_CACHE_PORTADA_SEG=15
# TTL de la lista de categorias (chips del inicio y selectores).
LOCALIS_CACHE_CATEGORIAS_SEG=300

# Importación masiva asíncrona (CSV/Excel): responde HTTP 202 y procesa en
# segundo plano. Cola acotada + pool de hilos daemon con contexto de Flask.
# IMPORTANTE: la cola y el estado de los trabajos viven en memoria del worker.
# Mantén WEB_CONCURRENCY=1 (por defecto) para que el polling de estado siempre
# encuentre el trabajo. Para varios procesos usa un broker compartido (Redis/RQ).
# LOCALIS_IMPORT_QUEUE_MAX=200
# LOCALIS_IMPORT_WORKERS=2
# LOCALIS_IMPORT_JOB_TTL_SEC=3600
# Alta concurrencia: los archivos se spolean a disco (instance/cola_import) para
# soportar cientos de importaciones en cola sin agotar RAM.

# Catálogo maestro indexado (matching instantáneo de imágenes en importaciones).
# LOCALIS_MAESTRO_INDEX_TTL_SEC=600
# LOCALIS_MAESTRO_INDEX_MAX=100000

# Antifraude en comprobantes de pago móvil.
# La fecha leída por OCR debe ser reciente (por defecto hoy o ayer, ~24-48 h).
# LOCALIS_COMPROBANTE_EXIGIR_FECHA=1   # 0 desactiva la exigencia de fecha
# LOCALIS_COMPROBANTE_MAX_DIAS=1       # antigüedad máxima permitida (0 = solo hoy)
# Además, el hash SHA-256 de la imagen se guarda en pagos/solicitudes_pago y
# bloquea la reutilización del mismo archivo aunque cambie la referencia.

# ==========================================
# SISTEMA DE PAGOS (MODELO TRADICIONAL RESTAURADO)
# ==========================================
# Modelo base de suscripciones/planes ACTIVO por defecto: período de gracia
# (30 días de prueba) y límites de productos por volumen. Toda la lógica,
# tablas y endpoints de pago permanecen intactos. Define
# LOCALIS_PAGOS_HABILITADOS=0 solo si quieres volver a la fase gratuita.
LOCALIS_PAGOS_HABILITADOS=1

