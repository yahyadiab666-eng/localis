# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env a GitHub.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOCALIS_SECRET_KEY=
# Secreto opcional SOLO para los enlaces de vista previa de tiendas (pre-cuentas).
# Si se define, rotarlo revoca todos los enlaces de vista previa ya compartidos.
# Si se deja vacio, se usa LOCALIS_SECRET_KEY.
LOCALIS_PREVIEW_SECRET=
# Correos con permisos de administrador, separados por coma (o ';').
# Si se omite, se conserva el correo historico para no romper despliegues.
# Permite varios admins y cambiarlos sin desplegar codigo.
LOCALIS_ADMIN_EMAILS=
LOCALIS_WHATSAPP=
DATABASE_URL=
# --- Base de datos: rendimiento de conexiones (medido) ---
# Abrir una conexion nueva a Supabase cuesta ~1 s; una consulta ~0,1 s.
# Este ping periodico mantiene las conexiones del pool calientes para que el
# primer usuario tras un rato de calma no pague el segundo de conexion.
# LOCALIS_DB_KEEPALIVE=1
# LOCALIS_DB_KEEPALIVE_SEG=240
# Conexiones minimas del pool (mas = mas calientes, pero el arranque crea una
# por cada una): DB_POOL_MIN=2
# El diagnostico de /health/ready recorre information_schema (~0,7 s); se cachea.
# LOCALIS_DIAG_CACHE_SEG=30
# Copia desde Supabase Dashboard -> Settings -> API -> Project URL.
# Exactamente https://<ref>.supabase.co (sin comillas, sin /rest/v1, sin host pegado delante).
SUPABASE_URL=https://TU_REF.supabase.co
# Anon/publishable: solo PostgREST de lectura (opcional). NUNCA la uses para Storage.
SUPABASE_KEY=
# Obligatorio en backend para Storage (subidas). Nombre exacto:
# SUPABASE_SERVICE_ROLE_KEY (con E en ROLE). Dashboard -> Settings -> API ->
# service_role (secret). Si pegaste aqui la llave anon, Storage devolvera 403 RLS
# y las URLs de imagen quedaran en None. El JWT debe tener "role": "service_role".
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_IMAGENES=imagenes

# Pipeline profesional de imágenes (100% local, sin suscripciones de pago).
# Se activa solo cuando el producto NO tiene foto subida por el comerciante.
# Flujo: EAN/UPC -> búsqueda web [nombre]+[marca]+[categoría]+"venezuela"
# -> validación de calidad -> rembg (fondo blanco) -> Supabase Storage.
# Cobertura universal: si no hay imagen real, se asigna un placeholder
# profesional de la categoría inferida (backend/categorias_producto.py).
LOCALIS_IMG_PIPELINE=1
# Parámetros finos (opcionales):
# LOCALIS_IMG_MIN_SIDE=320
# LOCALIS_IMG_MAX_CANDIDATOS=8
# LOCALIS_IMG_BLUR_MIN=35
# LOCALIS_IMG_LADO_FINAL=800
# LOCALIS_IMG_MAX_CONCURRENT=1
# LOCALIS_IMG_BUDGET_SEC=120
# Relleno real en segundo plano (acotado por tiempo para no saturar 1 CPU):
# LOCALIS_IMG_CSV_MAX=2000
# LOCALIS_IMG_CSV_BUDGET_SEC=600
# Búsqueda ligera en paralelo + caché + fuentes locales por sitio:
# LOCALIS_IMG_PARALELO=4
# LOCALIS_IMG_CACHE_TTL_SEC=3600
# LOCALIS_IMG_SITIOS=2
# LOCALIS_IMG_SITIOS_EXTRA=
# Fuentes locales directas (URL de imagen sin scraping):
#   VTEX (catálogo público): ya incluye Locatel (VE) y distribuidores regionales
#   (Carulla, Olímpica, Plaza Vea, Jumbo). Añade más tiendas VTEX separadas por coma.
# LOCALIS_IMG_VTEX_HOSTS=
#   Mercado Libre Venezuela (API oficial; requiere token de aplicación MELI)
# MELI_ACCESS_TOKEN=
# Serper.dev (Google Images) — buscador principal de imágenes automáticas:
#   UNA consulta por producto (EAN primero; si no, nombre + descripción) y el
#   resultado queda en el registro permanente `imagenes_automaticas`.
#   Ante 429/cuota agotada se pausa y el producto queda pendiente (sin caché).
#   OBLIGATORIA: sin SERPER_API_KEY el pipeline queda en estado neutro.
SERPER_API_KEY=
# LOCALIS_SERPER_GL=ve
# LOCALIS_SERPER_HL=es
# LOCALIS_SERPER_TIMEOUT_SEC=12
# LOCALIS_SERPER_REINTENTOS=2
# LOCALIS_SERPER_LIMITE=10
# LOCALIS_SERPER_MIN_LADO=200
# Control de créditos: tope diario duro y caché de consultas repetidas.
# LOCALIS_SERPER_MAX_DIA=90
# LOCALIS_SERPER_CACHE_TTL_SEC=86400
# LOCALIS_SERPER_CACHE_MAX=2000
# Reintento de negativos (días antes de volver a buscar por un EAN sin imagen).
# LOCALIS_SERPER_NEGATIVO_TTL_DIAS=7
# Serper en la cascada paralela (0 = solo vía registro automático, 1 = activar):
# LOCALIS_IMG_SERPER_CASCADA=0
# LOCALIS_IMG_SERPER_PARALELO=2
# LOCALIS_SERPER_CONFIG_COOLDOWN_SEG=3600
# LOCALIS_SERPER_CUOTA_COOLDOWN_SEG=3600
# Diagnóstico de credenciales al arrancar (una consulta de prueba; 0/1):
# LOCALIS_SERPER_DIAGNOSTICO=0
# Buscadores API globales (opcionales; máxima cobertura tipo búsqueda humana):
# SERPAPI_KEY=
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_V7_KEY=
# Anti-bloqueo: proxy HTTP(S) si la IP del VPS está bloqueada por buscadores/CDN
# LOCALIS_HTTP_PROXY=
# Pool de proxies públicos dinámicos (opt-in; usa proxies de terceros):
# LOCALIS_HTTP_PROXY_PUBLICO=0
# LOCALIS_HTTP_REINTENTOS=3
# LOCALIS_HTTP_BACKOFF_SEG=0.4
# Rastreo og:image de páginas de producto (emula búsqueda manual):
# LOCALIS_IMG_BING_OG=1
# Reintentos de descarga (CDN intermitentes):
# LOCALIS_IMG_DESCARGA_INTENTOS=2
# Enriquecimiento en paralelo (I/O) y trabajadores:
# LOCALIS_IMG_PARALELO=4
# LOCALIS_IMG_PARALELO_MAX=8
# LOCALIS_IMG_TRABAJADORES=4
# LOCALIS_IMG_TRABAJADORES_MAX=8
# Reintento periódico de imágenes pendientes/rechazadas (sin falsos positivos):
#   Cola persistente: cada ciclo procesa un lote en 30-60 s y sigue hasta lograr fotos reales.
# LOCALIS_IMG_BACKFILL=1# LOCALIS_IMG_BACKFILL_LOTE=20
# LOCALIS_IMG_BACKFILL_COMERCIOS=2
# LOCALIS_IMG_BACKFILL_PRESUPUESTO=50
# LOCALIS_IMG_BACKFILL_INTERVALO=90
# Catálogo público: tamaño de página (navegable) y tiendas ocultas (IDs por coma).
# LOCALIS_CATALOGO_PAGINA=60
# LOCALIS_COMERCIOS_EXCLUIDOS=
# Autorreparación de imágenes por importación (0 desactiva).
# LOCALIS_IMG_REPARAR_MAX=40
# Importación CSV/XLS: qué hacer con productos que ya no vienen en el archivo.
#   eliminar (por defecto): sincronización espejo, borra de la tienda los ausentes.
#   desactivar: los oculta (activo=0) sin borrarlos. | off: no toca los ausentes.
LOCALIS_CSV_BAJAS=eliminar
# Respaldo visual: SOLO logo OFICIAL de marca (nunca monogramas inventados).
# LOCALIS_MARCA_LOGO_TTL_SEC=86400
# Whitelist estricta de dominios para imágenes (0 solo para depurar):
# LOCALIS_IMG_ESTRICTO=1
# Hosts globales (site:) para sectores estructurados (separados por coma):
# LOCALIS_IMG_SITIOS_GLOBALES=
# Límite de CPU (rembg nunca corre en paralelo):
# LOCALIS_IMG_MAX_CONCURRENT=1
# LOCALIS_REMBG_MODEL=u2net
# Nota: la primera ejecución descarga el modelo de rembg (~176 MB) desde GitHub
# hacia el disco del worker. Con 1 worker Gunicorn (WEB_CONCURRENCY=1) es suficiente.
# Dominios extra de confianza (separados por coma):
# LOCALIS_IMG_DOMINIOS_CONFIABLES=

# Content-Security-Policy opcional. Vacio = no se envia (por defecto, porque
# las plantillas usan estilos/onclick inline). Para probar en una rama:
# LOCALIS_CSP=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'
LOCALIS_CSP=
# CSP en modo "solo reporte": el navegador NO bloquea, solo reporta violaciones.
# Es la forma de medir el impacto de una CSP estricta con riesgo cero antes de
# imponerla (LOCALIS_CSP). Recomendado desplegarlo primero unos dias.
LOCALIS_CSP_REPORT_ONLY=

# --- Observabilidad ---
# Formato de logs: vacio = texto legible; 1 = JSON estructurado (recomendado
# en produccion para poder filtrar/alertar). Cada peticion emite una linea de
# acceso con metodo, ruta, estado, duracion y request-id.
LOCALIS_LOG_JSON=
# Nivel de logging del logger raiz (INFO por defecto).
LOCALIS_LOG_LEVEL=INFO
# Metricas Prometheus: 1 expone GET /metrics (contadores por clase de estado y
# percentiles de latencia). Vacio = /metrics responde 404. Pensado para 1 worker.
LOCALIS_METRICS=
# Sentry (opcional). Vacio = no-op. Con DSN, se activa la integracion Flask
# (complementa el reporte por email de los errores 5xx).
LOCALIS_SENTRY_DSN=
# Muestreo de trazas de Sentry (0 = solo errores; 0.1 = 10% de peticiones).
LOCALIS_SENTRY_TRACES=0

# --- Trafico persistido + reporte diario ---
# Contadores de trafico por dia (tabla metricas_diarias). Vacio/1 = activado;
# 0 = desactivado. Sobreviven al reinicio (a diferencia de /metrics).
LOCALIS_TRAFICO=
# Cada cuantos segundos se vuelcan a la BD los deltas en memoria (por defecto 45).
LOCALIS_TRAFICO_FLUSH_SEC=45
# Reporte diario DENTRO de la app (recomendado; no depende de GitHub ni de la
# rama por defecto). Vacio/1 = activado; 0 = desactivado. Requiere SMTP.
LOCALIS_REPORTE_DIARIO=
# Hora (UTC) a partir de la cual se envia. 13 UTC = 09:00 en Venezuela (UTC-4).
LOCALIS_REPORTE_HORA_UTC=13
# Cada cuantos segundos el planificador revisa si toca enviar (por defecto 600).
LOCALIS_REPORTE_REVISION_SEG=600
# Endpoint /tareas/reporte-trafico para un cron EXTERNO (opcional). Si esta
# vacio, la ruta responde 404. Si lo defines, debe coincidir con el secreto
# LOCALIS_CRON_TOKEN del repositorio (GitHub) u otro cron.
LOCALIS_CRON_TOKEN=

# --- Correo (SMTP) ---
# Se usa para el reporte diario de trafico y para las alertas de error. El
# reporte diario se envia a TODOS los LOCALIS_ADMIN_EMAILS. Con Gmail hace falta
# una "contrasena de aplicacion" (no la contrasena normal de la cuenta).
# Con SMTP_USER/SMTP_PASSWORD vacios, no se envia correo (no rompe nada).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USE_TLS=true
# Destino de las alertas de error (por defecto, el correo historico).
ERROR_REPORT_EMAIL=

# Rate limiting (Flask-Limiter) en endpoints sensibles (login, creacion de
# productos, pagos, importacion). Clave por usuario de sesion o IP.
# 0 lo desactiva. Limites pensados para no afectar trafico normal.
LOCALIS_RATE_LIMIT=1

# --- Cache en memoria (por worker; se pierde al reiniciar) ---
# TTL de la portada en segundos. 0 desactiva. Absorbe picos de trafico sin
# congelar demasiado el orden del "revoltijo".
LOCALIS_CACHE_PORTADA_SEG=15
# TTL de la lista de categorias (chips del inicio y selectores).
LOCALIS_CACHE_CATEGORIAS_SEG=300
# TTL (segundos) de los listados publicos con mas trafico: la pagina de tienda y
# las busquedas del catalogo. Cada una cuesta varias consultas con ~0,7 s de ida
# y vuelta a la BD; servirlas de memoria multiplica la capacidad ante picos.
# 0 desactiva (consulta directa). TTL corto: un cambio del comerciante se ve en
# segundos.
LOCALIS_CACHE_TIENDA_SEG=20
LOCALIS_CACHE_CATALOGO_SEG=10
# Tope de entradas de la cache en memoria (evita que crezca sin control).
# LOCALIS_CACHE_MAX_ENTRIES=2000

# Importación masiva asíncrona (CSV/Excel): responde HTTP 202 y procesa en
# segundo plano. Cola acotada + pool de hilos daemon con contexto de Flask.
# IMPORTANTE: la cola y el estado de los trabajos viven en memoria del worker.
# Mantén WEB_CONCURRENCY=1 (por defecto) para que el polling de estado siempre
# encuentre el trabajo. Para varios procesos usa un broker compartido (Redis/RQ).
# LOCALIS_IMPORT_QUEUE_MAX=200
# LOCALIS_IMPORT_WORKERS=2
# LOCALIS_IMPORT_JOB_TTL_SEC=3600
# Alta concurrencia: los archivos se spolean a disco (instance/cola_import) para
# soportar cientos de importaciones en cola sin agotar RAM.

# Métricas (observabilidad). Con LOCALIS_METRICS=1 se publica /metrics en formato
# Prometheus: peticiones por clase, latencia, y OCR de comprobantes (volumen,
# resultado de monto incompleto/excedido y latencia).
# LOCALIS_METRICS=1
# LOCALIS_METRICS_BUFFER=500
# Si defines LOCALIS_METRICS_TOKEN, /metrics exige ?token=... o la cabecera
# X-Metrics-Token (recomendado si el endpoint es accesible desde internet).
# LOCALIS_METRICS_TOKEN=

# Catálogo maestro indexado (matching instantáneo de imágenes en importaciones).
# LOCALIS_MAESTRO_INDEX_TTL_SEC=600
# LOCALIS_MAESTRO_INDEX_MAX=100000

# Rendimiento web.
# Compresión gzip de las respuestas de texto (HTML/JSON/JS). La portada pasa de
# ~220 KB a ~17 KB (93 % menos), clave en redes móviles. Activa por defecto.
# LOCALIS_GZIP=0                       # 0 desactiva la compresión
# Recarga de plantillas. En producción se apaga sola; solo se enciende en
# desarrollo (o con este override explícito).
# LOCALIS_TEMPLATES_AUTORELOAD=0

# Antifraude en comprobantes de pago móvil.
# La fecha leída por OCR debe ser reciente (por defecto hoy o ayer, ~24-48 h).
# LOCALIS_COMPROBANTE_EXIGIR_FECHA=1   # 0 desactiva la exigencia de fecha
# LOCALIS_COMPROBANTE_MAX_DIAS=1       # antigüedad máxima permitida (0 = solo hoy)
# Además, el hash SHA-256 de la imagen se guarda en pagos/solicitudes_pago y
# bloquea la reutilización del mismo archivo aunque cambie la referencia.
#
# OCR: rendimiento. El motor se precarga al arrancar (en segundo plano) para que
# el primer pago no pague el coste del modelo. Las capturas se reescalan al lado
# mayor indicado antes de leerlas (acota tiempo y memoria sin perder texto).
# 1800 es el valor medido como óptimo; bajarlo de 1400 hace fallar la detección.
# LOCALIS_OCR_WARMUP=1                 # 0 desactiva la precarga del motor
# LOCALIS_OCR_MAX_DIM=1800             # lado mayor máximo antes de OCR (px)
# El OCR es caro y el contenedor tiene poca CPU: sin tope, una ráfaga de pagos
# acapara todos los hilos y deja el sitio lento. Este es el máximo simultáneo.
# LOCALIS_OCR_MAX_CONCURRENTES=2
#
# Hilos por worker de Gunicorn (WEB_CONCURRENCY=1 + N hilos es lo recomendado:
# cada petición espera ~0,7 s a la BD, así que varios hilos multiplican la
# capacidad sin más CPU y sin romper las colas/cachés en memoria).
# GUNICORN_THREADS=8

# ==========================================
# SISTEMA DE PAGOS (MODELO TRADICIONAL RESTAURADO)
# ==========================================
# Modelo base de suscripciones/planes ACTIVO por defecto: período de gracia
# (30 días de prueba) y límites de productos por volumen. Toda la lógica,
# tablas y endpoints de pago permanecen intactos. Define
# LOCALIS_PAGOS_HABILITADOS=0 solo si quieres volver a la fase gratuita.
LOCALIS_PAGOS_HABILITADOS=1

# Binance Pay (2.ª forma de pago, opcional). El comercio paga el monto del plan
# en USDT a este Pay ID; se verifica por captura (OCR) + aprobación del admin.
# Cambia el ID si usas otra cuenta. Vacio = no se muestra la opción.
LOCALIS_BINANCE_ID=1054151954
# Verificación REAL del pago contra la API de Binance (opcional, recomendado).
# Con estas llaves (permiso SOLO LECTURA, sin retiros) la app confirma por el ID
# de la orden que el pago existe de verdad, en vez de fiarse solo de la captura.
# NUNCA subas estas llaves al repositorio.
LOCALIS_BINANCE_API_KEY=
LOCALIS_BINANCE_API_SECRET=
# Días hacia atrás que se consultan al buscar la orden. El comprobante se exige
# con un máximo de 1 día de antigüedad (LOCALIS_COMPROBANTE_MAX_DIAS), así que
# 3 días cubren desfases de zona horaria. No hace falta tocarlo.
LOCALIS_BINANCE_VENTANA_DIAS=3
# Presupuesto de tiempo (segundos) para verificar UNA orden contra Binance.
# Si se agota, el pago queda "no verificado" y pasa a revisión manual en lugar
# de seguir esperando. Debe quedar por debajo del timeout de Gunicorn (120 s).
# LOCALIS_BINANCE_PRESUPUESTO_SEG=20

# --- Ubicaciones: relleno automático de ciudad/zona desde Google Maps ---
# Los comercios ya no escriben ciudad/zona a mano: se derivan del enlace de
# Google Maps. Los enlaces cortos (maps.app.goo.gl/...) se resuelven (redirección
# de Google) y las coordenadas se geocodifican al revés con OpenStreetMap
# (Nominatim, gratis y sin clave) para obtener ciudad, zona y dirección.
# Ponlo en 0 para apagarlo: la sede se guarda igual, solo sin ciudad/zona.
# LOCALIS_GEOCODIFICACION=1
# Servicio de geocodificación inversa (no suele hacer falta cambiarlo).
# LOCALIS_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# Identificador que viaja en el User-Agent (Nominatim lo exige).
# LOCALIS_GEO_USER_AGENT=Localis/1.0 (marketplace Venezuela; uso moderado)
# Tiempo máximo por petición y presupuesto total por lote de sedes (segundos).
# El presupuesto debe cubrir el máximo de 10 sedes (~1 req/s en Nominatim);
# si se queda corto, las últimas sedes se guardan sin ciudad/zona.
# LOCALIS_GEOCODIFICACION_TIMEOUT_SEG=5
# LOCALIS_GEOCODIFICACION_PRESUPUESTO_SEG=25

# --- Tasa de cambio (BCV) ---
# La tasa se actualiza SOLA, una vez al día, con el valor OFICIAL de
# https://www.bcv.org.ve/ (scraping propio; nunca dolarapi ni otras APIs de
# terceros) y se guarda redondeada a 2 decimales. Ponlo en 0 para volver al
# modo manual del panel admin.
# LOCALIS_TASA_AUTO_BCV=1
# Si el BCV no responde, cuánto esperar antes de reintentar el mismo día (seg).
# LOCALIS_TASA_AUTO_REINTENTO_SEG=1800
# Cada cuánto revisa el hilo de fondo si cambió el día (seg).
# LOCALIS_TASA_AUTO_INTERVALO_SEG=900
# 0 desactiva el hilo de fondo (queda la sincronización al primer uso del día).
# LOCALIS_TASA_AUTO_HILO=1

# --- Asistente de IA (atención al cliente, SOLO informativo) ---
# Apagado salvo que exista una clave y no se fuerce a 0. El widget aparece como
# un botón discreto en la web (y en la TWA, que carga la web remota) en la
# portada, la tienda pública, el panel del comerciante, el panel admin y la guía.
# Con LOCALIS_ASISTENTE=0 el widget no se muestra y la API responde 503.
# Importante: por ahora NO toca la base de datos. Solo responde con la
# documentación (RAG) y deriva a WhatsApp cuando hace falta una intervención.
# Proveedor por defecto: OpenRouter (API compatible con OpenAI). Basta con
# definir la clave para activarlo; cambiar de modelo/proveedor es solo env.
LOCALIS_ASISTENTE_API_KEY=
# LOCALIS_ASISTENTE=1
# LOCALIS_ASISTENTE_BASE_URL=https://openrouter.ai/api/v1
# Modelo recomendado (barato y rápido). Alternativas en OpenRouter:
#   google/gemini-2.0-flash-001   meta-llama/llama-3.3-70b-instruct
# LOCALIS_ASISTENTE_MODELO=openai/gpt-4o-mini
# Cabeceras que OpenRouter usa para atribuir el tráfico (opcionales).
# LOCALIS_ASISTENTE_SITIO=https://localis.onrender.com
# LOCALIS_ASISTENTE_TITULO=Localis
# Límites de coste y rendimiento (1 worker + pocos hilos: no saturar el proceso).
# LOCALIS_ASISTENTE_MAX_CONCURRENTES=2     # consultas simultáneas al LLM
# LOCALIS_ASISTENTE_MAX_TOKENS=500         # tope de la respuesta
# LOCALIS_ASISTENTE_TIMEOUT_SEG=20
# LOCALIS_ASISTENTE_TEMPERATURA=0.3
# LOCALIS_ASISTENTE_MAX_HISTORIAL=8        # turnos recordados por conversación
# LOCALIS_ASISTENTE_LIMITE_MENSAJE=1500    # caracteres máximos por mensaje
# LOCALIS_ASISTENTE_MAX_CONTEXTO=4000      # caracteres de documentación inyectados
# Destino del botón "Escribir a soporte" (por defecto, el WhatsApp de soporte).
# LOCALIS_ASISTENTE_WHATSAPP_URL=

