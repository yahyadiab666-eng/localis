# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env a GitHub.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOCALIS_SECRET_KEY=
LOCALIS_WHATSAPP=
DATABASE_URL=
# Copia desde Supabase Dashboard -> Settings -> API -> Project URL.
# Exactamente https://<ref>.supabase.co (sin comillas, sin /rest/v1, sin host pegado delante).
SUPABASE_URL=https://TU_REF.supabase.co
# Anon/publishable: solo PostgREST de lectura (opcional). NUNCA la uses para Storage.
SUPABASE_KEY=
# Obligatorio en backend para Storage (subidas). Nombre exacto:
# SUPABASE_SERVICE_ROLE_KEY (con E en ROLE). Dashboard -> Settings -> API ->
# service_role (secret). Si pegaste aqui la llave anon, Storage devolvera 403 RLS
# y las URLs de imagen quedaran en None. El JWT debe tener "role": "service_role".
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_IMAGENES=imagenes
